{
    "name": "broodfonds/keycloak-filament-admin",
    "description": "Keycloak Filament Admin UI",
    "keywords": [
        "Broodfonds",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "keycloak-filament-admin"
    ],
    "homepage": "https://github.com/broodfonds/keycloak-filament-admin",
    "support": {
        "issues": "https://github.com/broodfonds/keycloak-filament-admin/issues",
        "source": "https://github.com/broodfonds/keycloak-filament-admin"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Sebastian Kurfuerst",
            "email": "sebastian.kurfuerst@sandstorm.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0",
        "guzzlehttp/guzzle": "^7.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Broodfonds\\KeycloakFilamentAdmin\\": "src/",
            "Broodfonds\\KeycloakFilamentAdmin\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Broodfonds\\KeycloakFilamentAdmin\\Tests\\": "tests/",
            "Sandstorm\\KeycloakAdminApi\\": "../keycloak-admin-api/src"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Broodfonds\\KeycloakFilamentAdmin\\KeycloakFilamentAdminServiceProvider"
            ],
            "aliases": {
                "KeycloakFilamentAdmin": "Broodfonds\\KeycloakFilamentAdmin\\Facades\\KeycloakFilamentAdmin"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}