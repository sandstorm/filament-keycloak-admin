{
    "name": "sandstorm/filament-keycloak-admin",
    "description": "Filament v4 admin UI for managing Keycloak users through the Keycloak Admin REST API",
    "keywords": [
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "keycloak"
    ],
    "homepage": "https://github.com/sandstorm/filament-keycloak-admin",
    "license": "MIT",
    "authors": [
        {
            "name": "Sebastian Kurfuerst",
            "email": "sebastian.kurfuerst@sandstorm.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0",
        "guzzlehttp/guzzle": "^7.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "sandstorm/keycloak-admin-api": "*"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Sandstorm\\FilamentKeycloakAdmin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sandstorm\\FilamentKeycloakAdmin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sandstorm\\FilamentKeycloakAdmin\\FilamentKeycloakAdminServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
